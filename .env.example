# ============================================
# Nurse Resource Binder - Environment Variables
# ============================================
# 
# This file documents all environment variables needed for the project.
# Copy this file to create your actual .env files:
# 
# For development, you can use this as a reference and create:
# - client/.env (for frontend)
# - server/.env (for backend)
#
# Or use a single root .env if you configure both services to load from it.
# ============================================

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database connection string (for direct PostgreSQL access)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ============================================
# GOOGLE GEMINI API
# ============================================
# Get your API key from: https://aistudio.google.com/app/apikey
# Used for AI-powered resource tagging

GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# FRONTEND CONFIGURATION (Vite)
# ============================================
# These variables MUST be prefixed with VITE_ to be accessible in the browser
# Place these in: client/.env

VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# BACKEND CONFIGURATION (FastAPI)
# ============================================
# Place these in: server/.env

# Supabase configuration (same as above, but without VITE_ prefix)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# AI Service
# GEMINI_API_KEY=your_gemini_api_key_here

# CORS configuration
FRONTEND_URL=http://localhost:5173

# Environment
ENVIRONMENT=development

# ============================================
# OPTIONAL: POSTHOG ANALYTICS
# ============================================
# Uncomment if using PostHog for analytics

# POSTHOG_API_KEY=your_posthog_api_key
# POSTHOG_HOST=https://app.posthog.com

# ============================================
# NOTES
# ============================================
# 
# 1. Frontend variables (VITE_*) are bundled into the client code at build time.
#    Only use VITE_ prefix for values that are safe to expose publicly.
#
# 2. Backend variables are server-side only and never exposed to the browser.
#    Use these for sensitive keys like SERVICE_ROLE_KEY and GEMINI_API_KEY.
#
# 3. In production:
#    - Vercel: Set environment variables in Vercel dashboard
#    - Fly.io: Use `fly secrets set KEY=value` command
#    - Supabase: Set in Supabase dashboard for each project
#
# 4. Never commit actual .env files to git (they're in .gitignore)
